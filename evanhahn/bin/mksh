#!/usr/bin/env bash
set -e
set -u
set -o pipefail

if [ ! $# -eq 1 ]; then
  echo 'mksh takes one argument' 1>&2
  exit 1
elif [ -e "$1" ]; then
  echo "$1 already exists" 1>&2
  exit 1
fi

echo '#!/usr/bin/env bash
# Exits the script immediately if any command fails (returns non-zero).
set -e
# Treats references to unset variables as errors and exits immediately.
set -u
# Causes a pipeline to fail if any command inside it fails, not just the last one.
set -o pipefail

' > "$1"

chmod u+x "$1"

"$EDITOR" "$1"
